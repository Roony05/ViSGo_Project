{
  "name": "vis-go",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port=4173",
    "start": "tsx server/index.ts",
    "serve": "npm run build && npm start",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "seed": "tsx scripts/seed-firestore.ts",
    "split:avatars": "tsx scripts/split-avatars.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-visgo \"node scripts/rules.test.mjs\"",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:api": "bash scripts/deploy-cloudrun.sh",
    "deploy:web": "npm run build && firebase deploy --only hosting",
    "deploy:all": "npm run deploy:api && npm run deploy:web",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "test:e2e": "node scripts/e2e-live.mjs",
    "test:avatars": "node scripts/avatars.test.mjs",
    "test:kyc": "node scripts/kyc.test.mjs",
    "test:videos": "node scripts/videos.test.mjs",
    "test:hostchat": "node scripts/hostchat.test.mjs",
    "test:youtube": "tsx scripts/youtube.test.ts",
    "cloudrun:verify": "bash scripts/verify-cloudrun-cost.sh",
    "cloudrun:destroy": "bash scripts/destroy-cloudrun.sh"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
