# ==========================================================================
#  ViS-Go — Cấu hình môi trường
#  Copy file này thành `.env` rồi điền key. File `.env` đã được .gitignore.
#      cp .env.example .env
# ==========================================================================


# --------------------------------------------------------------------------
# 1. GEMINI AI  —  MIỄN PHÍ, KHÔNG CẦN THẺ TÍN DỤNG
# --------------------------------------------------------------------------
# Dùng cho: trợ lý ViS-AI (chatbot) và nút "Smart Translate" của Host.
#
# Cách lấy key (2 phút):
#   1. Vào https://aistudio.google.com/apikey
#   2. Đăng nhập Google -> "Create API key" -> "Create API key in new project"
#   3. Copy key (dạng AIza...) và dán vào dưới đây
#
# Free tier bao gồm các model Flash / Flash-Lite với giới hạn request/phút và
# request/ngày. Không cần gắn thẻ. Không bị tính tiền.
#
# Key này chỉ nằm ở server (Vite dev server hoặc server/index.ts), KHÔNG bị
# đóng gói vào bundle trình duyệt — người dùng cuối không đọc được.
GEMINI_API_KEY=

# Tuỳ chọn. Bỏ trống thì app tự dò model khả dụng theo thứ tự ghi trong
# server/gemini.ts (MODEL_CANDIDATES):
#   gemini-3-flash-preview -> gemini-3.1-flash-lite
#   -> gemini-flash-lite-latest -> gemini-flash-latest
#
# ⚠️ Tên model Gemini bị xoay vòng khá thường xuyên, và không phải model nào
#    trong danh sách công khai cũng gọi được bằng key của bạn. Muốn biết chắc
#    key này dùng được model nào:
#
#      curl -s https://generativelanguage.googleapis.com/v1beta/models \
#           -H "x-goog-api-key: $GEMINI_API_KEY" | grep '"name"'
#
#    Rồi thử gọi thật một model trong đó — có model nằm trong danh sách nhưng
#    khi gọi generateContent thì không bao giờ trả lời.
GEMINI_MODEL=


# --------------------------------------------------------------------------
# 2. GOOGLE OAUTH (Gmail + Calendar)  —  MIỄN PHÍ, KHÔNG CẦN THẺ TÍN DỤNG
# --------------------------------------------------------------------------
# Dùng cho: gửi email xác nhận booking THẬT qua Gmail của người dùng, và tạo
# sự kiện THẬT trên Google Calendar của họ.
#
# Cách lấy Client ID (khoảng 10 phút, xem hướng dẫn chi tiết trong README.md):
#   1. https://console.cloud.google.com/  -> tạo project mới
#   2. "APIs & Services" > "Library" -> bật **Gmail API** và **Google Calendar API**
#   3. "APIs & Services" > "OAuth consent screen":
#        - User type: External
#        - Thêm chính email của bạn vào mục "Test users"
#        - Scopes: .../auth/gmail.send  và  .../auth/calendar.events
#   4. "APIs & Services" > "Credentials" > "Create Credentials"
#        > "OAuth client ID" > Application type: **Web application**
#        - Authorized JavaScript origins:
#              http://localhost:3000
#              http://localhost:4173
#              (thêm domain production của bạn khi deploy)
#   5. Copy "Client ID" (dạng xxxxx.apps.googleusercontent.com) dán vào đây.
#
# Client ID là thông tin CÔNG KHAI theo thiết kế của Google — an toàn khi để ở
# client. KHÔNG BAO GIỜ đặt Client Secret vào file có tiền tố VITE_.
#
# Bỏ trống: app tự động chuyển sang chế độ link (mở sẵn Gmail compose và
# Google Calendar với nội dung điền sẵn). Vẫn chạy tốt, chỉ là người dùng phải
# tự bấm "Gửi" / "Lưu".
VITE_GOOGLE_CLIENT_ID=

# Tài khoản Google HỆ THỐNG gửi biên bản cho khách/host và tạo sự kiện mời
# host ngay khi booking được ghi nhận. Các biến này chỉ nằm ở backend; tuyệt
# đối không thêm tiền tố VITE_.
#
# Cách lấy refresh token:
#   1. Dùng cùng OAuth Client ở trên nhưng giữ Client Secret ở backend.
#   2. Mở https://developers.google.com/oauthplayground
#   3. Settings -> Use your own OAuth credentials -> nhập Client ID/Secret.
#   4. Cấp hai scope:
#        https://www.googleapis.com/auth/gmail.send
#        https://www.googleapis.com/auth/calendar.events
#   5. Authorize -> Exchange authorization code -> copy Refresh token.
#
# Gmail hệ thống là người tổ chức lịch và mời email host. Host chắc chắn nhận
# invitation; Google có tự đặt nó lên lịch host hay không còn tùy cài đặt
# "Add invitations to my calendar" của chính tài khoản host.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REFRESH_TOKEN=


# --------------------------------------------------------------------------
# 3. GOOGLE MAPS  —  ⚠️  BẮT BUỘC GẮN THẺ TÍN DỤNG
# --------------------------------------------------------------------------
# Dùng cho: bản đồ GPS Radar theo dõi Host thời gian thực.
#
# ⚠️  LƯU Ý CHI PHÍ: Google bỏ khoản credit $200/tháng từ 01/03/2025. Hiện
#     Maps JavaScript API cho 10.000 map loads/tháng miễn phí, NHƯNG vẫn bắt
#     buộc phải tạo billing account có thẻ thật mới cấp được API key.
#
# 👉 BỎ TRỐNG BIẾN NÀY nếu bạn không muốn gắn thẻ. App sẽ tự động dùng
#    Leaflet + OpenStreetMap — hoàn toàn miễn phí, không cần key, không cần
#    thẻ, và có đầy đủ tính năng GPS/marker/lộ trình y hệt.
#
# Nếu sau này muốn bật Google Maps: bật "Maps JavaScript API" trong Cloud
# Console, tạo API key, giới hạn key theo HTTP referrer, rồi dán vào đây.
# Không cần sửa một dòng code nào.
VITE_GOOGLE_MAPS_API_KEY=


# --------------------------------------------------------------------------
# 4. Khác
# --------------------------------------------------------------------------
# Cổng cho server production (npm start).
PORT=3000

# ============================================================
# 4. FIREBASE  —  MIỄN PHÍ, KHÔNG CẦN THẺ  (gói Spark)
# ============================================================
# Dùng cho: đăng nhập thật + lưu tour/booking/review lên cloud
# (thay cho localStorage), đồng bộ giữa nhiều máy.
#
# QUAN TRỌNG VỀ CHI PHÍ:
#   Gói Spark KHÔNG THỂ bị tính tiền — nó không gắn thẻ nào cả.
#   Khi hết quota, Firebase báo lỗi chứ không bao giờ trừ tiền.
#   => Tuyệt đối KHÔNG bấm "Upgrade to Blaze".
#
#   Hạn mức Spark mỗi ngày: 50.000 lượt đọc / 20.000 lượt ghi,
#   1 GiB dữ liệu, 50.000 người dùng hoạt động mỗi tháng.
#
#   App này CỐ TÌNH không dùng Cloud Storage và Cloud Functions,
#   vì hai thứ đó bắt buộc phải lên Blaze (tức phải gắn thẻ).
#
# Lấy 4 giá trị dưới đây ở đâu:
#   1. https://console.firebase.google.com/ -> Add project
#   2. Bấm biểu tượng </> (Web) để tạo Web App
#   3. Copy từ đoạn firebaseConfig hiện ra
#   4. Vào Build -> Authentication -> Sign-in method
#      -> bật "Email/Password" và "Google"
#   5. Vào Build -> Firestore Database -> Create database
#      -> chọn "Start in production mode"
#      -> sang tab Rules, dán nội dung file firestore.rules -> Publish
#
# Cả 4 biến phải điền đủ; thiếu một cái là app tự quay về localStorage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ============================================================
# 5. CHỐT AN TOÀN CHI PHÍ
# ============================================================
# Google Maps là tích hợp DUY NHẤT trong dự án này có thể tốn tiền
# (bắt buộc gắn thẻ mới cấp được API key).
#
# Vì vậy chỉ dán VITE_GOOGLE_MAPS_API_KEY thôi là CHƯA ĐỦ để bật nó.
# Phải đặt thêm dòng dưới đây thành true thì Maps mới thật sự chạy.
#
# Để trống hoặc false  ->  bản đồ chạy bằng Leaflet + OpenStreetMap,
#                          miễn phí hoàn toàn, không cần key.
VITE_ALLOW_PAID_APIS=false

# ============================================================
# 6. MAPILLARY  —  MIỄN PHÍ, KHÔNG CẦN THẺ
# ============================================================
# Dùng cho: ảnh 360 độ THẬT của địa danh trong tab "Di sản VR".
#
# Vì sao là Mapillary: đây là nguồn ảnh 360 duy nhất vừa miễn phí
# vừa có độ phủ tốt ở Việt Nam — Be Group đã đóng góp khoảng
# 9 triệu ảnh 360 độ khắp Hà Nội và TP.HCM.
#
# Lấy token:
#   1. https://www.mapillary.com/  ->  Sign up (miễn phí, không thẻ)
#   2. https://www.mapillary.com/dashboard/developers
#   3. Register application -> copy "Client Token"
#
# Token này KHÔNG có tiền tố VITE_ nên nằm lại ở server,
# không bao giờ bị đóng gói vào bundle trình duyệt.
#
# Bỏ trống -> tab VR dùng cảnh dựng bằng thuật toán như hiện tại.
MAPILLARY_TOKEN=

# --------------------------------------------------------------------------
# 7. FIREBASE AI LOGIC  —  MIỄN PHÍ, KHÔNG CẦN THẺ  (gói Spark)
# --------------------------------------------------------------------------
# Dùng cho: gọi Gemini THẲNG từ trình duyệt mà KHÔNG cần server riêng.
#
# Firebase đứng giữa làm proxy và tự giữ khoá Gemini, nên GEMINI_API_KEY
# không cần nữa khi deploy tĩnh (Firebase Hosting).
#
# Bộ luật trả lời của ViS-AI nằm trong "server prompt template" trên Firebase,
# KHÔNG nằm trong bundle -> người dùng không đọc được. Sửa prompt ngay trong
# Firebase Console, không phải build lại app.
#
# Cách bật (xem chi tiết trong DEPLOY.md):
#   1. Firebase Console -> Build -> AI Logic -> chọn "Gemini Developer API"
#   2. Tab Prompt templates -> tạo 2 template, dán nội dung trong DEPLOY.md
#   3. Copy ID của từng template dán vào đây
#
# Bỏ trống -> app tự dùng /api/rag-chat của server (nếu có), rồi tới
# ragEngine.ts chạy offline. Không bao giờ chết.
VITE_FIREBASE_AI_CHAT_TEMPLATE=
VITE_FIREBASE_AI_TRANSLATE_TEMPLATE=

# reCAPTCHA v3 site key, cho Firebase App Check.
#
# Không có key thì AI Logic có thể bị Firebase từ chối (App Check được bật
# mặc định). Đây là thứ chặn người lạ copy endpoint về gọi ké quota của bạn.
#
# Lấy ở: Firebase Console -> App Check -> Apps -> đăng ký web app với
# reCAPTCHA v3. CHỌN v3, ĐỪNG chọn reCAPTCHA Enterprise.
#
# ⚠️ Từ 02/04/2026 free tier của reCAPTCHA còn 10.000 assessment/tháng (trước là
#    1 triệu). App Check tạo 1 assessment mỗi lần làm mới token (~1 giờ/lần), nên
#    hạn mức này tiêu theo LƯỢT TRUY CẬP chứ không theo số câu hỏi: khoảng 220
#    lượt/ngày. Đây là trần chặt nhất của cả dự án — xem COST.md.
#
#    Không gắn thẻ thì vượt trần chỉ là 429 (chatbot lùi về offline), không mất
#    tiền. Có gắn thẻ thì $8/tháng tới 100.000 assessment, tự động trừ.
#
# Site key là thông tin công khai theo thiết kế — an toàn khi để ở client.
VITE_RECAPTCHA_SITE_KEY=


# --------------------------------------------------------------------------
# 8. MAPILLARY CHO BẢN DEPLOY TĨNH
# --------------------------------------------------------------------------
# Chỉ điền khi deploy lên hosting TĨNH (Firebase Hosting), tức không có server
# để giữ MAPILLARY_TOKEN.
#
# Điền vào đây thì token nằm trong bundle, ai cũng đọc được. Chấp nhận được vì
# đây là "Client Token" của Mapillary: nó CHỈ đọc ảnh công khai. Không đụng
# được tài khoản, không upload được, không tiêu được tiền. Thư viện MapillaryJS
# của chính Mapillary cũng nhúng kiểu này.
#
# ⚠️ TUYỆT ĐỐI không làm điều tương tự với GEMINI_API_KEY. Key đó mua được
#    sức tính toán; bị lộ là người khác đốt quota hoặc tiêu tiền của bạn.
#
# Bỏ trống -> app gọi qua /api/panorama và token nằm lại ở server.
VITE_MAPILLARY_TOKEN=

# --------------------------------------------------------------------------
# 9. GỌI MIỄN PHÍ TRONG APP
# --------------------------------------------------------------------------
# Khách và host gọi cho nhau ngay trong khung chat của chuyến đi.
#
# VÌ SAO KHÔNG BAO GIỜ MẤT TIỀN. Mặc định cuộc gọi chạy trên Jitsi Meet công
# cộng: không tài khoản, không API key, không thẻ — nên KHÔNG có quan hệ thanh
# toán nào để phát sinh phí. Muốn đổi sang dịch vụ khác thì sửa VITE_CALL_DOMAIN,
# và ba cái trần bên dưới là thứ giữ cho lần đổi đó không biến thành hoá đơn:
# hết hạn mức là NÚT GỌI TẮT, không có chuyện chạy tiếp sang phần tính phí.
#
# KHÔNG LƯU DỮ LIỆU CUỘC GỌI. Không ghi âm, không nhật ký, không lưu ai gọi ai
# lúc nào. Thứ duy nhất được ghi là ba con số đếm trong localStorage của chính
# trình duyệt đó, chỉ để chặn cuộc gọi tiếp theo khi hết hạn mức.
#
# Bỏ trống tất cả là dùng mặc định bên dưới.

# Đặt "false" để ẩn hẳn nút gọi.
VITE_CALL_ENABLED=

# Máy chủ họp. Mặc định: meet.jit.si
VITE_CALL_DOMAIN=

# Chuỗi bí mật trộn vào tên phòng.
#
# ⚠️ NÊN ĐỔI TRƯỚC KHI DEPLOY THẬT. Phòng trên Jitsi công cộng là ai gõ đúng tên
#    thì vào được, nên tên phòng chính là ổ khoá. Tên phòng = SHA-256 của
#    (chuỗi này + mã booking), nên đổi chuỗi này là đổi toàn bộ tên phòng.
VITE_CALL_ROOM_SALT=

# Ba cái trần. Mặc định: 10000 phút/tháng, 30 phút/cuộc, 20 cuộc/ngày.
VITE_CALL_MINUTES_PER_MONTH=
VITE_CALL_MINUTES_PER_CALL=
VITE_CALL_CALLS_PER_DAY=


# --------------------------------------------------------------------------
# 10. MẬT KHẨU TÀI KHOẢN MẪU (chỉ dùng cho `npm run seed`)
# --------------------------------------------------------------------------
# Không có tiền tố VITE_ nên KHÔNG bao giờ lọt vào bundle gửi cho trình duyệt.
# Chỉ script scripts/seed-firestore.ts đọc, và nó chạy trên máy bạn.
#
# Vì sao mật khẩu để ở đây chứ không để trong file dữ liệu mẫu: mọi biến có tiền
# tố VITE_ đều bị nhúng vào bundle, ai mở F12 cũng đọc được. Biến SEED_ thì không.
# seed/fixtures.ts cũng đã bỏ hẳn trường password.
#
# Tối thiểu 6 ký tự (giới hạn của Firebase Auth). Đổi rồi chạy lại `npm run seed`
# là mật khẩu trên Firebase đổi theo.
SEED_PASSWORD=
SEED_ADMIN_PASSWORD=
